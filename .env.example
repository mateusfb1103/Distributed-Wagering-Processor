NODE_ENV=development
PORT=3000
APP_ROLES=api,consumer,outbox,pending-worker

# Runtime role (sem DDL e sem UPDATE/DELETE/TRUNCATE no ledger — D06 R-d)
DATABASE_URL=postgresql://dwp_app:dwp_app_dev@localhost:5432/wagering

# Migrator role (dona do schema; usada apenas em migrations — D06 R-d)
DATABASE_MIGRATOR_URL=postgresql://dwp_migrator:dwp_migrator_dev@localhost:5432/wagering

# SQS (MiniStack padrão; compatível com LocalStack via SQS_ENDPOINT — D08)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=000000000000
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo

# Timeouts, polling e políticas (D01, D09, D10, D11)
LOCK_TIMEOUT_MS=2000
PENDING_REFERENCE_TTL_MS=900000
SHUTDOWN_TIMEOUT_MS=15000
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
PENDING_WORKER_POLL_INTERVAL_MS=500
PENDING_WORKER_BATCH_SIZE=50
SQS_WAIT_TIME_SECONDS=5
SQS_MAX_MESSAGES=10
# Somente para testes (ignorado em NODE_ENV=production)
# FAULT_INJECTION_POINT=
